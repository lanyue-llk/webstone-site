/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; upgrade-insecure-requests
/
  Cache-Control: no-store, max-age=0
/benchmarks/*
  Cache-Control: no-store, max-age=0
/results/*
  Cache-Control: no-store, max-age=0
/release.json
  Cache-Control: no-store, max-age=0
/versioning*
  Cache-Control: no-store, max-age=0
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
/cache-reset
  Cache-Control: no-store, max-age=0
  Clear-Site-Data: "cache"
